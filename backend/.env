# AI City Environment Configuration
APP_NAME="AI City Core"
APP_ENV="development"
DEBUG=true

# Server
HOST="127.0.0.1"
PORT=8000

# Paths
DATABASE_PATH="C:/AI_CITY/backend/data/ai_city.db"
WORKSPACE_PATH="C:/AI_CITY/backend/workspace"
SKILLS_DIR="C:/AI_CITY/skills/registry"

# ==============================================================
# LLM PROVIDER CONFIGURATION
# ==============================================================
# Pilihan Provider: mock | groq | openai | ollama | lmstudio
LLM_PROVIDER="ollama"

# OPSI A: GROQ (GRATIS, CEPAT, TANPA BEBAN GPU - REKOMENDASI LAPTOP 16GB)
# Dapatkan API Key gratis di: https://console.groq.com/keys
# LLM_PROVIDER="groq"
LLM_BASE_URL="http://127.0.0.1:11434"
LLM_MODEL="qwen3.5:9b"
# LLM_API_KEY="gsk_..."

# OPSI B: OLLAMA LOKAL (Jika terinstal di Windows)
# LLM_PROVIDER="ollama"
# OLLAMA_BASE_URL="http://127.0.0.1:11434"
# OLLAMA_MODEL="qwen2.5:3b"

# OPSI C: LM STUDIO LOKAL (Jika menggunakan GUI LM Studio)
# LLM_PROVIDER="lmstudio"
# LMSTUDIO_BASE_URL="http://127.0.0.1:1234/v1"
# LMSTUDIO_MODEL="local-model"

# OPSI D: OPENAI / OPENROUTER / DEEPSEEK
# LLM_PROVIDER="openai"
# LLM_BASE_URL="https://api.openai.com/v1"
# LLM_MODEL="gpt-4o-mini"
# LLM_API_KEY="sk-..."

# Simulation Parameters
TICK_INTERVAL_SECONDS=5.0
SIMULATION_SPEED=1.0
AUTO_TICK_ENABLED=true
